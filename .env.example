# DevOps Toolbox Environment Configuration Example
# Copy to .env and adjust variables accordingly

# AI SysAdmin Copilot Configuration
COPILOT_LOG_LEVEL=INFO
COPILOT_ANOMALY_THRESHOLD=0.75
COPILOT_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/EXAMPLE/WEBHOOK/KEY

# Backup & Storage Automation
BACKUP_TARGET_DIR=/var/backups/postgres
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPTION_RECIPIENT=ops@enterprise.internal

# Cloud Cost Optimization Targets
AWS_DEFAULT_REGION=eu-west-3
IDLE_CPU_THRESHOLD_PCT=5.0
IDLE_DAYS_THRESHOLD=14

# Ansible Target Configuration
ANSIBLE_REMOTE_USER=deployer
ANSIBLE_BECOME_METHOD=sudo
